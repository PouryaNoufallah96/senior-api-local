# Kinde (see https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your-subdomain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# Database (SQLite via Prisma driver adapter; relative paths resolve from the project root)
DATABASE_URL="file:./dev.db"

# API
# Expose the Scalar API reference and OpenAPI spec (/api/v1/docs) in production.
API_DOCS_ENABLED=false
